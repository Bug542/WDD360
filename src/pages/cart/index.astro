---
import BaseLayout from "../../layouts/BaseLayout.astro";
import cartScript from "../../js/cart.js?url";

const title = "Cart";
---

<BaseLayout title={title}>
  <h2>Cart</h2>

  <p>
    Items in cart:
    <span id="cart-count">0</span>
  </p>

  <button id="add-to-cart">Add to Cart</button>

  <script src={cartScript}></script>
</BaseLayout>